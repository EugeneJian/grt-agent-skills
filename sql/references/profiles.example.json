{
  "default_profile": "intranet",
  "profiles": {
    "intranet": {
      "engine": "mssql_rd_delivery",
      "database": "oa_report",
      "host_env": "OA_HOST",
      "port_env": "OA_PORT",
      "user_env": "OA_USER",
      "password_env": "OA_PWD",
      "delivery_scope": {
        "sales_unit": "UNSPECIFIED"
      },
      "max_rows": 1000,
      "timeout_seconds": 30
    },
    "cloud": {
      "engine": "supabase_api",
      "url_env": "COMPANY_SUPABASE_URL",
      "apikey_env": "COMPANY_SUPABASE_API_KEY",
      "jwt_env": "COMPANY_SUPABASE_USER_JWT",
      "api_schema": "agent_api",
      "credentials_file": "~/.config/company-sql/cloud-auth.json",
      "max_rows": 1000,
      "timeout_seconds": 30
    }
  }
}
